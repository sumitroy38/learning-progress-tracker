# Copy this file to .env and fill in your own values. Never commit the real .env file.

# The port the API listens on
PORT=4000

# The main database. Use your own PostgreSQL user and password.
# If your PostgreSQL has no password, write it like this: postgres://YOUR_USER@localhost:5432/lpt
DATABASE_URL=postgres://YOUR_USER:YOUR_PASSWORD@localhost:5432/lpt

# A separate database that the automated tests are allowed to erase.
# Its name must contain the word test, or the tests refuse to run.
TEST_DATABASE_URL=postgres://YOUR_USER:YOUR_PASSWORD@localhost:5432/lpt_test

# A long random text that signs the login cookies. Make one with: npm run secret
SESSION_SECRET=paste_the_output_of_npm_run_secret_here
